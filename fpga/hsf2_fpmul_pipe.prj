#project folders
add_folder {rtl}  
add_folder {rtl/alu}  
add_folder {rtl/renorm}  
add_folder {rtl/postproc}  
add_folder {rtl/common}  
add_folder {infra}  
add_folder {infra/src}  
add_folder {infra/rtl/datapath}  
add_folder {infra/pkg}  
add_folder {pkg}  

#project files
add_file -verilog -vlog_std sysv -folder {infra/pkg} "../fusesoc_libraries/hasunosora-hdl-infra.git/proj/pkg/hs_ifr_misc_typedefs_pkg.sv"
add_file -verilog -vlog_std sysv -folder {infra/pkg} "../fusesoc_libraries/hasunosora-hdl-infra.git/proj/pkg/hs_math_basic_pkg.sv"
add_file -verilog -vlog_std sysv -folder {infra/rtl/datapath} "../fusesoc_libraries/hasunosora-hdl-infra.git/proj/rtl/datapath/hs_dpath_skid_buffer.sv"
add_file -verilog -vlog_std sysv -folder {pkg} "../proj/pkg/hsf2_typedef_pkg.sv"
add_file -verilog -vlog_std sysv -folder {rtl} "../proj/rtl/hsf2_fpmul_pipe.sv"
add_file -verilog -vlog_std sysv -folder {rtl/renorm} "../proj/rtl/renorm/hsf2_renorm.sv"
add_file -verilog -vlog_std sysv -folder {rtl/postproc} "../proj/rtl/postproc/hsf2_grs_round.sv"
add_file -verilog -vlog_std sysv -folder {rtl/postproc} "../proj/rtl/postproc/hsf2_postproc.sv"
add_file -verilog -vlog_std sysv -folder {rtl/common} "../proj/rtl/common/hsf2_lshift.sv"
add_file -verilog -vlog_std sysv -folder {rtl/common} "../proj/rtl/common/hsf2_grs_rshift.sv"
add_file -verilog -vlog_std sysv -folder {rtl/alu} "../proj/rtl/alu/hsf2_alu.sv"
add_file -verilog -vlog_std sysv -folder {rtl/alu} "../proj/rtl/alu/hsf2_bvd.sv"
add_file -verilog -vlog_std sysv -folder {rtl/alu} "../proj/rtl/alu/hsf2_cmul.sv"
add_file -verilog -vlog_std sysv -folder {rtl/alu} "../proj/rtl/alu/hsf2_exp_extract.sv"
add_file -verilog -vlog_std sysv -folder {rtl/alu} "../proj/rtl/alu/hsf2_exp_sum.sv"
add_file -verilog -vlog_std sysv -folder {rtl/alu} "../proj/rtl/alu/hsf2_hblzc.sv"
add_file -verilog -vlog_std sysv -folder {rtl/alu} "../proj/rtl/alu/hsf2_sp_result_gen.sv"


#implementation: "rev_1"
impl -add rev_1 -type fpga

#
#implementation attributes

set_option -vlog_std sysv
set_option -num_startend_points 5
set_option -project_relative_includes 1
set_option -include_path {../proj/include/;../fusesoc_libraries/hasunosora-hdl-infra.git/proj/include/}

#par_1 attributes
set_option -job par_1 -add par

#device options
set_option -technology KINTEX-ULTRASCALEPLUS-FPGAS
set_option -part XCKU5P
set_option -package FFVA676
set_option -speed_grade -1-e
set_option -part_companion ""

#compilation/mapping options
set_option -use_fsm_explorer 0
set_option -top_module "hsf2_fpmul_pipe"

# hdl_compiler_options
set_option -distributed_compile 1
set_option -hdl_strict_syntax 0

# mapper_without_write_options
set_option -frequency 350.000000
set_option -srs_instrumentation 1

# mapper_options
set_option -write_verilog 1
set_option -write_vhdl 0

# xilinx_options
set_option -rw_check_on_ram 1
set_option -reporting_ctd slack
set_option -optimize_ngc 1

# Xilinx Virtex2
set_option -run_prop_extract 1
set_option -maxfan 10000
set_option -disable_io_insertion 0
set_option -pipe 1
set_option -update_models_cp 0
set_option -retiming 0
set_option -no_sequential_opt 0
set_option -no_sequential_opt_bram_mapping both
set_option -fix_gated_and_generated_clocks 1

# Xilinx Kintex UltraScale+ FPGAs
set_option -enable_prepacking 1
set_option -use_vivado 1

# timing_analyst_options
set_option -reporting_filter {-from {{{i:alu_renorm_pipe_inst.fth_dp\.out_data\.flags\.prod_cout_2_rep1}} } -to {{i:renorm_postproc_pipe_inst.fth_dp\.out_data\.flags\.grs\.sticky} }}
set_option -reporting_number_paths 1
set_option -reporting_netlist /home/onodera/Projects/ip/Arithmetic/hsf2-fpmul-pipe/fpga/rev_1/synth_index_1.srm
set_option -reporting_output_srm 0

# sequential_optimization_options
set_option -symbolic_fsm_compiler 1

# Compiler Options
set_option -compiler_compatible 0
set_option -resource_sharing 1
set_option -multi_file_compilation_unit 1

# Compiler Options
set_option -auto_infer_blackbox 0

#timing report file option
set_option -reporting_filename "rev_1/synth_index_1.ta"

#automatic place and route (vendor) options
set_option -write_apr_constraint 1

#set result format/file last
project -result_file "rev_1/hsf2_fpmul_pipe.edf"

#design plan options
impl -active "rev_1"
